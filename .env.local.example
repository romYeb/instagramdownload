# ─── Instagram ─────────────────────────────────────────────────────────────────
# Récupérées via F12 → Application → Cookies → https://www.instagram.com
INSTAGRAM_SESSION_ID=your_sessionid_cookie
INSTAGRAM_CSRF_TOKEN=your_csrftoken_cookie

# ─── TikTok ────────────────────────────────────────────────────────────────────
# User-Agent optionnel (par défaut : Chrome 120 simulé)
TIKTOK_USER_AGENT=

# ─── Proxy HTTP (optionnel) ─────────────────────────────────────────────────────
# Format : http://user:pass@host:port
# Permet de contourner les blocages IP Instagram / TikTok
PROXY_URL=http://user:pass@host:port
TIKTOK_PROXY_URL=

# ─── Supabase (optionnel — historique persistant) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
