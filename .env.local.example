# ─── Instagram OAuth ──────────────────────────────────────────────────────────
# 1. Créez une app sur https://developers.facebook.com/
# 2. Ajoutez le produit "Instagram Login"
# 3. Renseignez l'URI de redirection : http://localhost:3000/api/auth/callback
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ─── Supabase (optionnel — historique persistant) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
